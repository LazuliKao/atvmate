#!/bin/sh /etc/rc.common
# ATV Mate init script for OpenWrt (procd)

USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled port listen adb_server

	config_load atvmate
	config_get_bool enabled main enabled 1
	config_get port main port 8000
	config_get listen main listen "0.0.0.0"
	config_get adb_server main adb_server "127.0.0.1:5037"

	[ "$enabled" -eq 1 ] || {
		echo "atvmate is disabled in UCI config"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/bin/atvmate
	procd_append_param command --port "$port"
	procd_append_param command --listen "$listen"
	procd_append_param command --adb-server "$adb_server"
	procd_append_param command --frontend-dir /usr/share/atvmate/frontend
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	service_stop /usr/bin/atvmate
}

reload_service() {
	stop
	start
}
